{
  "name": "dsh-multi-window-context-management",
  "version": "0.7.0",
  "description": "Windowed context handoffs on top of DeepSeek Harness (DSH) native compaction, with session-private notes and paged history recall",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/overact/dsh-multi-window-context-management.git"
  },
  "homepage": "https://github.com/overact/dsh-multi-window-context-management#readme",
  "bugs": {
    "url": "https://github.com/overact/dsh-multi-window-context-management/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "lib",
    "scripts/dsh-env.mjs",
    "scripts/preflight.mjs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "cordis.patch.yml",
    "locale",
    "assets"
  ],
  "engines": {
    "node": ">=22.15",
    "dsh": ">=0.1.7-alpha.1 || >=0.2.0-0 <0.2.2-0 || >=0.2.2-0"
  },
  "scripts": {
    "preflight": "node scripts/preflight.mjs",
    "test": "node --experimental-test-isolation=none --test test/*.test.js",
    "check": "node scripts/check.mjs",
    "verify": "npm run check && npm run test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "context-management",
    "windowing",
    "history-notes",
    "token-budget"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.1.7-alpha.1 || >=0.2.0-0 <0.2.2-0 || >=0.2.2-0",
    "@deepseek-ai/dsh-atomic-write": ">=0.1.7-alpha.1 || >=0.2.0-0 <0.2.2-0 || >=0.2.2-0",
    "@deepseek-ai/dsh-home-paths": ">=0.1.7-alpha.1 || >=0.2.0-0 <0.2.2-0 || >=0.2.2-0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.2"
  }
}
